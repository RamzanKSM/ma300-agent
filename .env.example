# Network address of the C2000-BIOAccess-MA300.
MA300_HOST=192.168.1.201
MA300_PORT=4370
MA300_TIMEOUT_SECONDS=10
MA300_PASSWORD=0
MA300_FORCE_UDP=true
MA300_OMIT_PING=true
MA300_VERBOSE=false
MA300_RECONNECT_DELAY_SECONDS=3
# Check the MA300 session after this many seconds without packets; 0 turns the check off.
MA300_IDLE_CHECK_SECONDS=30

# The agent must normally stay accessible only from the reception computer.
AGENT_HOST=127.0.0.1
AGENT_PORT=8765
LOG_LEVEL=INFO
# Optional rotating log file (1 MB x 5). Without a console (pythonw.exe) the
# agent logs to logs/ma300-agent.log next to app.py when LOG_FILE is empty.
LOG_FILE=
