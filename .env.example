# Network address of the C2000-BIOAccess-MA300.
MA300_HOST=192.168.1.201
MA300_PORT=4370
MA300_TIMEOUT_SECONDS=10
MA300_PASSWORD=0
MA300_FORCE_UDP=true
MA300_OMIT_PING=true
MA300_VERBOSE=false
MA300_RECONNECT_DELAY_SECONDS=3

# The agent must normally stay accessible only from the reception computer.
AGENT_HOST=127.0.0.1
AGENT_PORT=8765
LOG_LEVEL=INFO
